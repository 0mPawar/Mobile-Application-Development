<?xml version="1.0" encoding="utf-8"?>
<!-- activity_second.xml — SecondActivity (launched via Explicit Intent) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- ══════════════════════════════════════════════════
             HEADER BANNER
        ══════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1565C0"
            android:padding="24dp"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📩"
                android:textSize="48sp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Second Activity"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Launched via Explicit Intent"
                android:textSize="13sp"
                android:textColor="#90CAF9"/>

        </LinearLayout>

        <!-- ══════════════════════════════════════════════════
             RECEIVED DATA CARD
             Populated in Java from Intent.getStringExtra()
        ══════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data received from MainActivity:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <!-- Name row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="👤  Name"
                    android:textSize="13sp"
                    android:textColor="#888888"/>

                <TextView
                    android:id="@+id/tvReceivedName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="—"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:gravity="end"/>

            </LinearLayout>

            <!-- Email row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="✉️  Email"
                    android:textSize="13sp"
                    android:textColor="#888888"/>

                <TextView
                    android:id="@+id/tvReceivedEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="—"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:gravity="end"/>

            </LinearLayout>

            <!-- Message row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💬  Message"
                    android:textSize="13sp"
                    android:textColor="#888888"/>

                <TextView
                    android:id="@+id/tvReceivedMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="—"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:gravity="end"/>

            </LinearLayout>

        </LinearLayout>

        <!-- ══════════════════════════════════════════════════
             INTENT SYNTAX REFERENCE CARD
        ══════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Explicit Intent Syntax Used:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Intent intent = new Intent(\n    MainActivity.this,\n    SecondActivity.class);\nintent.putExtra(&quot;NAME&quot;, name);\nintent.putExtra(&quot;EMAIL&quot;, email);\nintent.putExtra(&quot;MESSAGE&quot;, msg);\nstartActivity(intent);"
            android:textSize="12sp"
            android:textColor="#1A237E"
            android:fontFamily="monospace"
            android:background="#E3F2FD"
            android:padding="14dp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp"/>

        <!-- Send Reply button back to MainActivity -->
        <Button
            android:id="@+id/btnSendReply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="↩️  SEND REPLY TO MAINACTIVITY"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1565C0"
            android:padding="13dp"
            android:layout_marginBottom="12dp"/>

        <!-- Back button -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="← BACK"
            android:textSize="13sp"
            android:textColor="#1565C0"
            android:backgroundTint="#E3F2FD"
            android:padding="12dp"/>

    </LinearLayout>
</ScrollView>