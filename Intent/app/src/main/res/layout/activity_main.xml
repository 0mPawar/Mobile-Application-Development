<?xml version="1.0" encoding="utf-8"?>
<!-- activity_main.xml — Intent Demo: MainActivity -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ══════════════════════════════════════════════════
             HEADER
        ══════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#3F51B5"
            android:padding="20dp"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📨"
                android:textSize="40sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Android Intents Demo"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explicit Intent  •  Implicit Intent"
                android:textSize="12sp"
                android:textColor="#C5CAE9"/>

        </LinearLayout>

        <!-- ══════════════════════════════════════════════════
             SECTION A — EXPLICIT INTENT
             Navigate to SecondActivity within this app.
        ══════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A.  Explicit Intent"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#3F51B5"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Targets a specific component inside the same app.\nnew Intent(MainActivity.this, SecondActivity.class)"
            android:textSize="12sp"
            android:textColor="#666666"
            android:fontFamily="monospace"
            android:background="#E8EAF6"
            android:padding="10dp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="12dp"/>

        <!-- User info input for Explicit Intent -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter details to pass to SecondActivity:"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="12dp"/>

            <!-- Name field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textSize="12sp"
                android:textColor="#555555"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Vikas"
                android:inputType="textPersonName"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="12dp"/>

            <!-- Email field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textSize="12sp"
                android:textColor="#555555"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. vikas@example.com"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="14dp"/>

            <!-- Message field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Message"
                android:textSize="12sp"
                android:textColor="#555555"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Hello from MainActivity!"
                android:inputType="text"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="16dp"/>

            <!-- Open SecondActivity -->
            <Button
                android:id="@+id/btnExplicit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚀  OPEN SECOND ACTIVITY  (Explicit)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#3F51B5"
                android:padding="13dp"/>

        </LinearLayout>

        <!-- ══════════════════════════════════════════════════
             SECTION B — IMPLICIT INTENT: Open Websites
             Uses ACTION_VIEW + Uri.parse() to open in browser.
        ══════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="B.  Implicit Intent — Open Website"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#009688"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No specific component named.\nIntent.ACTION_VIEW + Uri.parse(url)"
            android:textSize="12sp"
            android:textColor="#666666"
            android:fontFamily="monospace"
            android:background="#E0F7FA"
            android:padding="10dp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="8dp">

            <!-- Custom URL input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter a URL to open:"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etCustomUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://www.google.com"
                android:inputType="textUri"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnOpenCustomUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌐  OPEN CUSTOM URL"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#009688"
                android:padding="12dp"
                android:layout_marginBottom="16dp"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="14dp"/>

            <!-- Preset website buttons -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Or tap a preset site:"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="10dp"/>

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnGoogle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔍 Google"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#4285F4"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/btnYouTube"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="▶ YouTube"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FF0000"/>

            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnWikipedia"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📖 Wikipedia"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#555555"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/btnGithub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🐙 GitHub"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#24292E"/>

            </LinearLayout>

        </LinearLayout>

        <!-- ══════════════════════════════════════════════════
             SECTION C — OTHER IMPLICIT INTENTS
        ══════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="C.  Other Implicit Intents"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#E65100"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ACTION_DIAL, ACTION_SENDTO, ACTION_SEARCH\nEach triggers a different system app."
            android:textSize="12sp"
            android:textColor="#666666"
            android:fontFamily="monospace"
            android:background="#FFF3E0"
            android:padding="10dp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <!-- Phone number input -->
            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Phone number for Dial intent"
                android:inputType="phone"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="10dp"/>

            <!-- Email address input -->
            <EditText
                android:id="@+id/etEmailImplicit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email address for Send Email intent"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="10dp"/>

            <!-- Search query input -->
            <EditText
                android:id="@+id/etSearchQuery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search query (Google Search)"
                android:inputType="text"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="14dp"/>

            <!-- Row: Dial + Email -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnDial"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📞 DIAL"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#43A047"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="✉️ EMAIL"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1E88E5"/>

            </LinearLayout>

            <!-- Search button -->
            <Button
                android:id="@+id/btnSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔍  WEB SEARCH  (ACTION_WEB_SEARCH)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#E65100"
                android:padding="12dp"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>