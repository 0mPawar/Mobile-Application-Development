<?xml version="1.0" encoding="utf-8"?>
<!-- activity_main.xml — Date Picker Application -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- ══════════════════════════════════════════════════
             HEADER
        ══════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅  Date Picker"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#3F51B5"
            android:gravity="center"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select dates using the picker controls below"
            android:textSize="13sp"
            android:textColor="#888888"
            android:gravity="center"
            android:layout_marginBottom="28dp"/>

        <!-- ══════════════════════════════════════════════════
             SECTION 1 — Inline DatePicker (always visible)
             This is a DatePicker widget embedded directly in
             the layout — no button needed to show it.
             calendarViewShown="false" shows the spinner style
             (Day/Month/Year scroll wheels) as in your screenshot.
             spinnersShown="true"  ensures scroll-wheel style.
        ══════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1.  Inline Date Picker (Spinner Style)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#3F51B5"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="8dp">

            <!--
                DatePicker attributes:
                calendarViewShown="false" — hides calendar grid, shows spinner wheels
                spinnersShown="true"      — shows Day / Month / Year scroll wheels
                datePickerMode="spinner"  — explicitly requests the spinner (scroll) style
                    This matches the "Pick a date" screenshot you provided.
            -->
            <DatePicker
                android:id="@+id/datePickerInline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:calendarViewShown="false"
                android:spinnersShown="true"
                android:datePickerMode="spinner"/>

        </LinearLayout>

        <!-- Confirm button for inline picker -->
        <Button
            android:id="@+id/btnConfirmInline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✔  CONFIRM DATE"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3F51B5"
            android:padding="13dp"
            android:layout_marginBottom="10dp"/>

        <!-- Output for inline picker -->
        <TextView
            android:id="@+id/tvInlineResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No date confirmed yet."
            android:textSize="14sp"
            android:textColor="#555555"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="28dp"/>

        <!-- ══════════════════════════════════════════════════
             SECTION 2 — DatePickerDialog
             A dialog that pops up when the button is pressed.
             This is the most common real-world usage.
        ══════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2.  DatePickerDialog (Pop-up)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#3F51B5"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap the button below to open a DatePickerDialog.\nThis is the standard Android approach for forms and booking flows."
                android:textSize="13sp"
                android:textColor="#666666"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="14dp"/>

            <!-- Selected date display field (looks like an input box) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#F5F5F5"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅  "
                    android:textSize="18sp"/>

                <TextView
                    android:id="@+id/tvDialogSelectedDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="No date selected"
                    android:textSize="15sp"
                    android:textColor="#888888"/>

            </LinearLayout>

            <Button
                android:id="@+id/btnOpenDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📅  PICK A DATE"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#009688"
                android:padding="13dp"/>

        </LinearLayout>

        <!-- Output for dialog picker -->
        <TextView
            android:id="@+id/tvDialogResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No date selected yet."
            android:textSize="14sp"
            android:textColor="#555555"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="28dp"/>

        <!-- ══════════════════════════════════════════════════
             SECTION 3 — Date Range Picker
             Pick a Start Date and End Date, then validate.
        ══════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3.  Date Range Picker (Check-in / Check-out)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#3F51B5"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="8dp">

            <!-- Check-in Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Check-in Date"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#F5F5F5"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/tvCheckIn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tap to select"
                    android:textSize="14sp"
                    android:textColor="#888888"/>

                <Button
                    android:id="@+id/btnCheckIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅"
                    android:textSize="16sp"
                    android:backgroundTint="#E8EAF6"
                    android:textColor="#3F51B5"
                    android:padding="8dp"/>

            </LinearLayout>

            <!-- Check-out Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Check-out Date"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#F5F5F5"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/tvCheckOut"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tap to select"
                    android:textSize="14sp"
                    android:textColor="#888888"/>

                <Button
                    android:id="@+id/btnCheckOut"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅"
                    android:textSize="16sp"
                    android:backgroundTint="#E8EAF6"
                    android:textColor="#3F51B5"
                    android:padding="8dp"/>

            </LinearLayout>

            <Button
                android:id="@+id/btnCheckRange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✔  CONFIRM BOOKING"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF9800"
                android:padding="12dp"/>

        </LinearLayout>

        <!-- Range result -->
        <TextView
            android:id="@+id/tvRangeResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select both dates to see booking details."
            android:textSize="14sp"
            android:textColor="#555555"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>