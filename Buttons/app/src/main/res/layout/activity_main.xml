<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF"
    android:orientation="vertical"
    android:padding="24dp">
    <!--  Title TextView  -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:gravity="center"
        android:text="Button Demo App"
        android:textColor="#3F51B5"
        android:textSize="24sp"
        android:textStyle="bold" />
    <!--  ==================== SECTION 1: Normal Button ====================  -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="1. Normal Button"
        android:textColor="#333333"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnNormal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#3F51B5"
        android:padding="12dp"
        android:text="Click Me!"
        android:textColor="#FFFFFF" />
    <!--  Output for Normal Button  -->
    <TextView
        android:id="@+id/tvBtnOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="#FFFFFF"
        android:padding="8dp"
        android:text="Button not clicked yet."
        android:textColor="#555555"
        android:textSize="14sp" />
    <!--  ==================== SECTION 2: ImageButton ====================  -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="2. Image Button"
        android:textColor="#333333"
        android:textSize="16sp"
        android:textStyle="bold" />
    <!--  ImageButton uses a built-in Android system icon  -->
    <ImageButton
        android:id="@+id/imgBtn"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#E8F5E9"
        android:contentDescription="Play Button"
        android:padding="12dp"
        android:src="@android:drawable/ic_media_play" />
    <!--  Output for ImageButton  -->
    <TextView
        android:id="@+id/tvImgBtnOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="#FFFFFF"
        android:padding="8dp"
        android:text="Image button not clicked yet."
        android:textColor="#555555"
        android:textSize="14sp" />
    <!--  ==================== SECTION 3: ToggleButton ====================  -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="3. Toggle Button"
        android:textColor="#333333"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ToggleButton
        android:id="@+id/toggleBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:checked="false"
        android:textOff="OFF"
        android:textOn="ON" />
    <!--  Output for ToggleButton  -->
    <TextView
        android:id="@+id/tvToggleOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="#FFFFFF"
        android:padding="8dp"
        android:text="Toggle is currently: OFF"
        android:textColor="#555555"
        android:textSize="14sp" />
    <!--  ==================== SECTION 4: Status Panel ====================  -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="16dp"
        android:background="#CCCCCC" />

    <TextView
        android:id="@+id/tvClickCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center"
        android:padding="10dp"
        android:text="Total Button Clicks: 0"
        android:textColor="#3F51B5"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>