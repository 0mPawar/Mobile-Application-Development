<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical"
    android:padding="24dp">
    <!--  Title TextView  -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="Student Registration"
        android:textColor="#3F51B5"
        android:textSize="24sp"
        android:textStyle="bold" />
    <!--  Label for Name  -->
    <TextView
        android:id="@+id/tvNameLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Enter Your Name:"
        android:textColor="#333333"
        android:textSize="16sp" />
    <!--  EditText for Name  -->
    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@android:drawable/edit_text"
        android:hint="Full Name"
        android:inputType="textPersonName"
        android:padding="12dp" />
    <!--  Label for City with AutoCompleteTextView  -->
    <TextView
        android:id="@+id/tvCityLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Enter Your City (AutoComplete):"
        android:textColor="#333333"
        android:textSize="16sp" />
    <!--  AutoCompleteTextView for City  -->
    <AutoCompleteTextView
        android:id="@+id/actvCity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@android:drawable/edit_text"
        android:completionThreshold="1"
        android:hint="Start typing city name..."
        android:padding="12dp" />
    <!--  Label for Email  -->
    <TextView
        android:id="@+id/tvEmailLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Enter Your Email:"
        android:textColor="#333333"
        android:textSize="16sp" />
    <!--  EditText for Email  -->
    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="@android:drawable/edit_text"
        android:hint="example@email.com"
        android:inputType="textEmailAddress"
        android:padding="12dp" />
    <!--  Submit Button  -->
    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#3F51B5"
        android:padding="14dp"
        android:text="SUBMIT"
        android:textColor="#FFFFFF" />
    <!--  Divider  -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="16dp"
        android:background="#CCCCCC" />
    <!--  Output Label  -->
    <TextView
        android:id="@+id/tvOutputLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Submitted Details:"
        android:textColor="#3F51B5"
        android:textSize="16sp"
        android:textStyle="bold" />
    <!--  Output TextView to display result  -->
    <TextView
        android:id="@+id/tvOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:lineSpacingExtra="6dp"
        android:padding="12dp"
        android:text="(Details will appear here)"
        android:textColor="#555555"
        android:textSize="15sp" />
</LinearLayout>