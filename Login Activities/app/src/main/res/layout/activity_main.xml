<?xml version="1.0" encoding="utf-8"?>
<!-- activity_main.xml — Login Screen (Activity 1) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center_horizontal">

        <!-- ══════════════════════════════════════════════════
             APP LOGO + TITLE
        ══════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔐"
            android:textSize="64sp"
            android:gravity="center"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign in to continue"
            android:textSize="14sp"
            android:textColor="#9FA8DA"
            android:layout_marginBottom="40dp"/>

        <!-- ══════════════════════════════════════════════════
             LOGIN CARD
        ══════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#16213E"
            android:padding="24dp">

            <!-- Username label + field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#9FA8DA"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter your username"
                android:inputType="textPersonName"
                android:padding="14dp"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textColorHint="#5C6BC0"
                android:background="#0F3460"
                android:layout_marginBottom="18dp"/>

            <!-- Password label + field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#9FA8DA"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter your password"
                android:inputType="textPassword"
                android:padding="14dp"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textColorHint="#5C6BC0"
                android:background="#0F3460"
                android:layout_marginBottom="24dp"/>

            <!-- Login Button -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LOGIN"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#3F51B5"
                android:padding="14dp"
                android:layout_marginBottom="14dp"/>

            <!-- Progress bar (hidden by default, shown during login) -->
            <ProgressBar
                android:id="@+id/progressBarLogin"
                style="@android:style/Widget.ProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                android:layout_marginBottom="10dp"/>

            <!-- Status message -->
            <TextView
                android:id="@+id/tvLoginStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:gravity="center"
                android:textColor="#EF9A9A"
                android:layout_marginBottom="6dp"/>

        </LinearLayout>

        <!-- Hint text below card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter User Name Add Password"
            android:textSize="12sp"
            android:textColor="#5C6BC0"
            android:gravity="center"
            android:layout_marginTop="20dp"/>

        <!-- ══════════════════════════════════════════════════
             LIFECYCLE LOG — shows which lifecycle methods fired
        ══════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activity Lifecycle Log:"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#7986CB"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvLifecycleLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="#5C6BC0"
            android:fontFamily="monospace"
            android:background="#0F3460"
            android:padding="12dp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>