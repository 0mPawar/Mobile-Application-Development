<?xml version="1.0" encoding="utf-8"?>
<!-- list_booking_item.xml
     Layout for a single row in the bookings ListView.
     Each row: guest avatar icon + name, room, dates + status badge.
     Place in: res/layout/list_booking_item.xml
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="14dp"
    android:background="#FFFFFF">

    <!-- Guest avatar ImageView — left side -->
    <ImageView
        android:id="@+id/ivGuestAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_myplaces"
        android:background="#E8EAF6"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:contentDescription="Guest Avatar"/>

    <!-- Booking status badge — right side -->
    <TextView
        android:id="@+id/tvBookingStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirmed"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#4CAF50"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"/>

    <!-- Guest name — to the right of avatar -->
    <TextView
        android:id="@+id/tvGuestName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Rahul Sharma"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:layout_toEndOf="@id/ivGuestAvatar"
        android:layout_toStartOf="@id/tvBookingStatus"
        android:layout_alignParentTop="true"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"/>

    <!-- Room info — below guest name -->
    <TextView
        android:id="@+id/tvBookingRoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Room 202 · Deluxe"
        android:textSize="12sp"
        android:textColor="#555555"
        android:layout_below="@id/tvGuestName"
        android:layout_toEndOf="@id/ivGuestAvatar"
        android:layout_marginStart="12dp"
        android:layout_marginTop="3dp"/>

    <!-- Check-in / Check-out dates — below room info -->
    <TextView
        android:id="@+id/tvBookingDates"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📅 14 Mar – 17 Mar 2026"
        android:textSize="11sp"
        android:textColor="#888888"
        android:layout_below="@id/tvBookingRoom"
        android:layout_toEndOf="@id/ivGuestAvatar"
        android:layout_marginStart="12dp"
        android:layout_marginTop="3dp"/>

</RelativeLayout>