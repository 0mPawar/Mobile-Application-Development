<?xml version="1.0" encoding="utf-8"?>
<!-- activity_main.xml — Hotel Management System Dashboard -->
<!-- Root: LinearLayout with a tab bar + FrameLayout to swap sections -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FF">

    <!-- ══════════════════════════════════════════════════════
         HEADER BAR
    ══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#3F51B5"
        android:gravity="center_vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏨"
            android:textSize="28sp"
            android:layout_marginEnd="10dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grand Palace Hotel"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Management System"
                android:textSize="12sp"
                android:textColor="#C5CAE9"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textSize="12sp"
            android:textColor="#C5CAE9"/>

    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════
         TAB BAR — 3 tabs to switch between sections
    ══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <!-- Tab 1: Rooms (GridView) -->
        <TextView
            android:id="@+id/tabRooms"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🏠 Rooms"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#3F51B5"
            android:gravity="center"
            android:padding="14dp"
            android:background="#E8EAF6"/>

        <!-- Tab 2: Bookings (ListView) -->
        <TextView
            android:id="@+id/tabBookings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📋 Bookings"
            android:textSize="13sp"
            android:textColor="#888888"
            android:gravity="center"
            android:padding="14dp"
            android:background="#FFFFFF"/>

        <!-- Tab 3: Info (ScrollView) -->
        <TextView
            android:id="@+id/tabInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ℹ️ Hotel Info"
            android:textSize="13sp"
            android:textColor="#888888"
            android:gravity="center"
            android:padding="14dp"
            android:background="#FFFFFF"/>

    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════
         CONTENT AREA — sections toggled via Java visibility
    ══════════════════════════════════════════════════════ -->

    <!-- ─── SECTION 1: ROOMS — GridView + ImageView ─────────────────── -->
    <!--
        GridView: displays items in a 2-column scrollable grid.
        Each cell contains an ImageView (room icon) + room details.
        numColumns="2" sets 2 columns; stretchMode fills width evenly.
    -->
    <LinearLayout
        android:id="@+id/sectionRooms"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Stats summary bar above the grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12" android:textSize="20sp"
                    android:textStyle="bold" android:textColor="#4CAF50"/>
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Available" android:textSize="11sp"
                    android:textColor="#888888"/>
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="40dp"
                android:background="#EEEEEE"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8" android:textSize="20sp"
                    android:textStyle="bold" android:textColor="#F44336"/>
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Occupied" android:textSize="11sp"
                    android:textColor="#888888"/>
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="40dp"
                android:background="#EEEEEE"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2" android:textSize="20sp"
                    android:textStyle="bold" android:textColor="#FF9800"/>
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maintenance" android:textSize="11sp"
                    android:textColor="#888888"/>
            </LinearLayout>

        </LinearLayout>

        <!--
            GridView attributes:
            numColumns="2"         — 2 columns
            horizontalSpacing      — gap between columns
            verticalSpacing        — gap between rows
            stretchMode="columnWidth" — columns stretch to fill width
        -->
        <GridView
            android:id="@+id/gridViewRooms"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="2"
            android:horizontalSpacing="8dp"
            android:verticalSpacing="8dp"
            android:stretchMode="columnWidth"
            android:padding="8dp"
            android:background="#F5F7FF"/>

    </LinearLayout>

    <!-- ─── SECTION 2: BOOKINGS — ListView ──────────────────────────── -->
    <!--
        ListView: displays a vertical scrollable list.
        Each row is inflated from list_booking_item.xml via a custom adapter.
        Built-in scrolling — do NOT wrap ListView inside a ScrollView.
    -->
    <LinearLayout
        android:id="@+id/sectionBookings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="  Recent Bookings"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#3F51B5"
            android:background="#FFFFFF"
            android:padding="14dp"/>

        <ListView
            android:id="@+id/listViewBookings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#EEEEEE"
            android:dividerHeight="1dp"
            android:background="#FFFFFF"/>

    </LinearLayout>

    <!-- ─── SECTION 3: HOTEL INFO — ScrollView + ImageView ──────────── -->
    <!--
        ScrollView: wraps a tall LinearLayout so it scrolls vertically.
        ImageView: displays the hotel banner image at the top.
        Use ScrollView when content is taller than the screen.
        IMPORTANT: ScrollView can only have ONE direct child.
    -->
    <ScrollView
        android:id="@+id/sectionInfo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#F5F7FF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ImageView: Hotel banner / hero image -->
            <!--
                ImageView attributes:
                scaleType="centerCrop" — crops image to fill bounds, maintains ratio
                adjustViewBounds       — adjusts bounds to match image aspect ratio
            -->
            <ImageView
                android:id="@+id/ivHotelBanner"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:scaleType="centerCrop"
                android:background="#3F51B5"
                android:contentDescription="Hotel Banner"/>

            <!-- Overlay text on banner using FrameLayout -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-60dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="#88000000"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grand Palace Hotel  •  ⭐⭐⭐⭐⭐"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>

                </LinearLayout>
            </FrameLayout>

            <!-- Hotel details card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About the Hotel"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#3F51B5"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Grand Palace Hotel is a premium 5-star property located in the heart of Pune. Established in 1998, we offer world-class amenities, personalized service, and an unforgettable experience for every guest."
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:lineSpacingExtra="4dp"/>

            </LinearLayout>

            <!-- Amenities Grid (ImageView icons in a grid) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amenities"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#3F51B5"
                    android:layout_marginBottom="12dp"/>

                <!-- Row 1 of amenity icons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <!-- ImageView used for amenity icon -->
                        <ImageView
                            android:layout_width="44dp" android:layout_height="44dp"
                            android:src="@android:drawable/ic_menu_compass"
                            android:background="#E8EAF6" android:padding="8dp"
                            android:contentDescription="Pool"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Pool" android:textSize="11sp" android:textColor="#555555"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <ImageView
                            android:layout_width="44dp" android:layout_height="44dp"
                            android:src="@android:drawable/ic_menu_directions"
                            android:background="#E8EAF6" android:padding="8dp"
                            android:contentDescription="Gym"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Gym" android:textSize="11sp" android:textColor="#555555"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <ImageView
                            android:layout_width="44dp" android:layout_height="44dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            android:background="#E8EAF6" android:padding="8dp"
                            android:contentDescription="Restaurant"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Restaurant" android:textSize="11sp" android:textColor="#555555"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <ImageView
                            android:layout_width="44dp" android:layout_height="44dp"
                            android:src="@android:drawable/ic_menu_search"
                            android:background="#E8EAF6" android:padding="8dp"
                            android:contentDescription="WiFi"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Free WiFi" android:textSize="11sp" android:textColor="#555555"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                </LinearLayout>

                <!-- Row 2 of amenity icons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <ImageView
                            android:layout_width="44dp" android:layout_height="44dp"
                            android:src="@android:drawable/ic_menu_mapmode"
                            android:background="#E8EAF6" android:padding="8dp"
                            android:contentDescription="Parking"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Parking" android:textSize="11sp" android:textColor="#555555"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <ImageView
                            android:layout_width="44dp" android:layout_height="44dp"
                            android:src="@android:drawable/ic_menu_agenda"
                            android:background="#E8EAF6" android:padding="8dp"
                            android:contentDescription="Spa"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Spa" android:textSize="11sp" android:textColor="#555555"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <ImageView
                            android:layout_width="44dp" android:layout_height="44dp"
                            android:src="@android:drawable/ic_menu_call"
                            android:background="#E8EAF6" android:padding="8dp"
                            android:contentDescription="Room Service"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Room Svc" android:textSize="11sp" android:textColor="#555555"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <ImageView
                            android:layout_width="44dp" android:layout_height="44dp"
                            android:src="@android:drawable/ic_menu_send"
                            android:background="#E8EAF6" android:padding="8dp"
                            android:contentDescription="Laundry"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Laundry" android:textSize="11sp" android:textColor="#555555"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Contact Info card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact Information"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#3F51B5"
                    android:layout_marginBottom="12dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📍  MG Road, Pune, Maharashtra 411001"
                    android:textSize="13sp" android:textColor="#555555" android:layout_marginBottom="8dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📞  +91 20 1234 5678"
                    android:textSize="13sp" android:textColor="#555555" android:layout_marginBottom="8dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✉️  reservations@grandpalace.com"
                    android:textSize="13sp" android:textColor="#555555" android:layout_marginBottom="8dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🌐  www.grandpalacehotel.com"
                    android:textSize="13sp" android:textColor="#3F51B5"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>